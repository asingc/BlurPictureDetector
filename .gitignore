# Downloaded model weights (large binaries — auto-downloaded on first run)
*.pt
*.task

# Python cache
__pycache__/
*.pyc
*.pyo

# Output artefacts
output/
annotated/
blurry.csv
blur.lst

# Test images (local only)
TestImg/

# Local lightweight working directory
lw/

# Event-specific working directories (local only)
efc2023/
efc2025/
TestImages/
# VS Code workspace settings (personal, not shared)
.vscode/
.Facereco/
.FaceReco.backup*/
*.log
Test/
test[0-9]*/

# Photo Culling web UI — local, per-machine data (never committed)
/team.json
/.culling_state.json

# InitPhotoProcessing.bat run directly from the repo root (install_root
# defaults to CWD) - local conda env / downloaded app copy / scratch files,
# never committed. Same-named folders under test*/ are already covered by
# the test[0-9]*/ pattern above.
/app/
/envs/
/_setup_tmp/
/RunPhotoProcessing.bat

